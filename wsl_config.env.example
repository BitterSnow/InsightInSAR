# 复制为 %LOCALAPPDATA%\InSAR\wsl_config.env 或工程根 wsl_config.env
# Desktop 启动时会加载（setdefault，不覆盖已设环境变量）
# CDS API 凭据请使用部署向导写入 %LOCALAPPDATA%\InSAR\cdsapirc，勿写入本文件

INSAR_WSL_DISTRO=Ubuntu
INSAR_WSL_ENV_SCRIPT=~/insar-wsl/env_isce2.sh
